{
  "manifest_version": 3,
  "name": "KaderGo - Експорт Z-звітів для Excel",
  "version": "1.0.0",
  "description": "Експорт та завантаження Z-звітів з кабінету платника податків (cabinet.tax.gov.ua) прямо у файл Excel (.xlsx) з ідеальним форматуванням.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://cabinet.tax.gov.ua/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KaderGo Z-Reports",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cabinet.tax.gov.ua/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

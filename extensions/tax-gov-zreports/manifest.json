{
  "manifest_version": 3,
  "name": "KaderGo - Експорт в Excel",
  "version": "1.5.8",
  "description": "Експорт та завантаження даних про оборот з кабінету платника податків у файл Excel (.xlsx) для системи KaderGo.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "https://cabinet.tax.gov.ua/cashregs/zreports*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KaderGo - Завантажити в Excel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cabinet.tax.gov.ua/cashregs/zreports*"
      ],
      "js": [
        "modules/config.js",
        "modules/zip.js",
        "modules/excel.js",
        "modules/downloader.js",
        "modules/date-utils.js",
        "modules/cabinet-interactor.js",
        "modules/table-scraper.js",
        "modules/exporter.js",
        "modules/modal.js",
        "modules/ui.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

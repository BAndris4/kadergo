{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kadergo",
  "version": "0.2.1",
  "identifier": "com.andris.kadergo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KaderGo - Система обліку ФОП",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNEQ1QzgwRTQ1MDEzRDAKUldUUUUxRGtnRnhORzBVU0gxc2pBTUJLYk14TFkwUERkK25jZWZmSHF4cUdabHludU40U1drb2wK",
      "endpoints": [
        "https://github.com/BAndris4/kadergo/releases/latest/download/latest.json"
      ]
    }
  }
}
